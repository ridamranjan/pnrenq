
# ============================================================
# PNR EXPERT
# Git attributes and line-ending normalization
# ============================================================

# Default text detection.
* text=auto

# ------------------------------------------------------------
# Android and JVM source files
# ------------------------------------------------------------

*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.aidl text eol=lf

# ------------------------------------------------------------
# Configuration and resource files
# ------------------------------------------------------------

*.gradle text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.pro text eol=lf
*.cfg text eol=lf
*.lockfile text eol=lf

# ------------------------------------------------------------
# Documentation
# ------------------------------------------------------------

*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.css text eol=lf

# ------------------------------------------------------------
# Scripts
# ------------------------------------------------------------

gradlew text eol=lf
gradlew.bat text eol=crlf

*.sh text eol=lf
*.bash text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.sql text eol=lf

# ------------------------------------------------------------
# Git configuration
# ------------------------------------------------------------

.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf

# ------------------------------------------------------------
# Images and graphical assets
# ------------------------------------------------------------

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.bmp binary
*.avif binary

*.svg text eol=lf

# ------------------------------------------------------------
# Fonts
# ------------------------------------------------------------

*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# ------------------------------------------------------------
# JVM and Android binaries
# ------------------------------------------------------------

*.jar binary
*.aar binary
*.class binary
*.dex binary
*.apk binary
*.aab binary
*.apks binary
*.ap_ binary

# ------------------------------------------------------------
# Native binaries
# ------------------------------------------------------------

*.so binary
*.dll binary
*.dylib binary
*.exe binary

# ------------------------------------------------------------
# Archives and database files
# ------------------------------------------------------------

*.zip binary
*.7z binary
*.rar binary
*.gz binary
*.tar binary
*.pdf binary

*.db binary
*.sqlite binary
*.sqlite3 binary

# ------------------------------------------------------------
# Signing-related binary formats
# ------------------------------------------------------------

*.jks binary
*.keystore binary
*.p12 binary
*.pfx binary
